# Server-only Gemini API key. Chat requests are proxied through Express;
# never expose this value using a VITE_ prefix.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

PORT="3000"
# Set this only when the backend is behind exactly one trusted reverse proxy.
# A shared/distributed rate-limit store is recommended for multi-instance production.
# TRUST_PROXY="true"

# Server-only Firebase Admin SDK configuration. Never prefix these with VITE_.
FIREBASE_PROJECT_ID="your-firebase-project-id"
GCLOUD_PROJECT="your-firebase-project-id"
FIRESTORE_DATABASE_ID=""
# Either provide GOOGLE_APPLICATION_CREDENTIALS to a private service-account file
# or set FIREBASE_SERVICE_ACCOUNT_JSON as a secret in the server environment.
# GOOGLE_APPLICATION_CREDENTIALS="C:/secure/path/to/firebase-admin-service-account.json"
# FIREBASE_SERVICE_ACCOUNT_JSON=""

# Server-only, comma-separated verified administrator emails.
# The original administrator is retained by default in server.ts.
# Add additional accounts only when intentionally granting administrator access.
# ADMIN_EMAILS="ba341914@gmail.com"

# Marketplace checkout policy; values must match the display currency used in product listings.
ORDER_CURRENCY="USD"
ORDER_TAX_RATE="0.05"
VITE_ORDER_CURRENCY="USD"
VITE_SUPPORT_EMAIL=""
# Public API origin for a separate Express deployment; leave unset when the frontend and API share an origin.
# VITE_API_BASE_URL="https://your-express-api.example.com"
# Server-only exact frontend origins allowed to call the API from a browser.
# CORS_ORIGINS="https://your-frontend.example.com"
# Optional public Firebase web config overrides for staging/local builds.
# These values are public client configuration, not secrets.
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_APP_ID=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_MEASUREMENT_ID=""
# VITE_FIREBASE_MESSAGING_SENDER_ID=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_STORAGE_BUCKET=""
# VITE_FIRESTORE_DATABASE_ID=""

# Optional payment instructions shown for manual bank transfer. Do not put them in client code.
# BANK_TRANSFER_INSTRUCTIONS=""

# JazzCash and Easypaisa endpoints intentionally return unavailable until official provider
# merchant documentation, credentials, callback URLs, and signature validation are configured.
