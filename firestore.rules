rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Fields:
    //   - uid: string (required)
    //   - email: string (required)
    //   - displayName: string
    //   - role: string (buyer, seller, admin) (required)
    //   - status: string (pending, approved, rejected) (required)
    //   - createdAt: timestamp (required)
    //
    // Collection: products
    // Fields:
    //   - name: string (required)
    //   - description: string
    //   - price: number (required)
    //   - sellerId: string (required)
    //   - stock: number (required)
    //   - category: string
    //   - images: list
    //   - createdAt: timestamp
    //
    // Collection: orders
    // Fields:
    //   - buyerId: string (required)
    //   - items: list (required)
    //   - totalAmount: number (required)
    //   - status: string (pending, paid, shipped, delivered) (required)
    //   - createdAt: timestamp
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "ba341914@gmail.com" && request.auth.token.email_verified == true));
    }

    function isSeller() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'seller';
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'status']) &&
             data.role in ['buyer', 'seller', 'admin'] &&
             data.status in ['pending', 'approved', 'rejected'] &&
             data.email is string && data.email.size() < 255;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'sellerId', 'stock']) &&
             data.name is string && data.name.size() < 100 &&
             data.price is number && data.price >= 0 &&
             data.stock is int && data.stock >= 0;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.role != 'admin';
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role);
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isSeller() && isValidProduct(request.resource.data) && request.resource.data.sellerId == request.auth.uid;
      allow update: if (isSeller() && resource.data.sellerId == request.auth.uid && isValidProduct(request.resource.data)) || isAdmin();
      allow delete: if (isSeller() && resource.data.sellerId == request.auth.uid) || isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.buyerId == request.auth.uid || isAdmin() || (isSeller() && resource.data.sellerId == request.auth.uid));
      allow create: if isAuthenticated() && request.resource.data.buyerId == request.auth.uid;
      allow update: if isAdmin() || (isSeller() && resource.data.sellerId == request.auth.uid);
    }
  }
}
