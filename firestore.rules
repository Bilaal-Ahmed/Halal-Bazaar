rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == "ba341914@gmail.com"
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userData(request.auth.uid).status == 'approved';
    }

    function isActiveAccount() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userData(request.auth.uid).status == 'approved';
    }

    function isApprovedSeller() {
      return isActiveAccount() && userData(request.auth.uid).role == 'seller';
    }

    function validProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'status', 'createdAt'])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL', 'role', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.uid is string
        && data.email is string
        && data.email.size() <= 254
        && data.displayName is string
        && data.displayName.size() <= 100
        && data.role == 'buyer'
        && data.status == 'approved';
    }

    function validProduct(data) {
      return data.keys().hasAll([
          'name', 'description', 'price', 'category', 'stock', 'sellerId',
          'sellerName', 'images', 'rating', 'numReviews', 'published', 'createdAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        && data.description is string
        && data.description.size() <= 5000
        && data.price is number
        && data.price > 0
        && data.stock is int
        && data.stock >= 0
        && data.category is string
        && data.category.size() <= 50
        && data.sellerId == request.auth.uid
        && data.sellerName is string
        && data.images is list
        && data.images.size() <= 8
        && (data.images.size() == 0
          || (data.images[0] is string && data.images[0].matches('https://.*')))
        && (!data.keys().hasAny(['isHalalCertified']) || data.isHalalCertified is bool)
        && data.rating is number
        && data.numReviews is int
        && data.published is bool;
    }

    match /users/{uid} {
      allow create: if isOwner(uid) && validProfile(request.resource.data);
      allow read: if isOwner(uid) || isAdmin();
      allow update: if isAdmin()
        || (isOwner(uid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
          && request.resource.data.get('sellerApplication', null) == resource.data.get('sellerApplication', null)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'displayName', 'photoURL', 'phone', 'city', 'country', 'postalCode',
            'defaultAddress', 'addresses', 'updatedAt'
          ]));
      allow delete: if isAdmin();
    }

    match /sellerApplications/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    match /products/{productId} {
      allow read: if resource.data.published == true
        || (signedIn() && resource.data.sellerId == request.auth.uid)
        || isAdmin();
      allow create: if isApprovedSeller()
        && validProduct(request.resource.data)
        && request.resource.data.isHalalCertified is bool
        && request.resource.data.rating == 0
        && request.resource.data.numReviews == 0
        && request.resource.data.published == true;
      allow update: if isAdmin()
        || (isApprovedSeller()
          && resource.data.sellerId == request.auth.uid
          && validProduct(request.resource.data)
          && request.resource.data.sellerId == resource.data.sellerId
          && request.resource.data.rating == resource.data.rating
          && request.resource.data.numReviews == resource.data.numReviews
          && request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if isAdmin()
        || (isApprovedSeller() && resource.data.sellerId == request.auth.uid);
    }

    match /orders/{orderId} {
      allow read: if signedIn()
        && (resource.data.buyerId == request.auth.uid
          || isAdmin());
      allow write: if false;
    }

    match /paymentReviews/{reviewId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.buyerId == request.auth.uid);
      allow write: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /platformSettings/{settingId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
